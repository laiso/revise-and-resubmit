{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revise-and-resubmit",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RUN",
        "class_name": "RunObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RunObject"]
    }
  ],
  "workflows": [
    {
      "name": "run-workflow",
      "binding": "RUN_WORKFLOW",
      "class_name": "RunWorkflow"
    }
  ]
}
